{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "電脳ミーム要塞",
  "version": "0.1.0",
  "identifier": "app.meme-fortress.dev",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "電脳ミーム要塞",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"]
  }
}
