[Unit]
Description=Meme Fortress backend (axum + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Web/meme-fortress
ExecStart=/home/ubuntu/Web/meme-fortress/target/release/meme-fortress-backend
Environment=PORT=8787
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5

# Light hardening (適宜緩める)
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
