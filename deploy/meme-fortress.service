[Unit]
Description=Meme Fortress backend (axum + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/Web/meme-fortress
ExecStart=/home/ubuntu/Web/meme-fortress/target/release/meme-fortress-backend
Environment=PORT=8787
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
